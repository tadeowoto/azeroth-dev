---
import { Avatar } from "./ui/warcraftcn/avatar";
---

<header
  class="w-full h-16 border-b border-border-color flex items-center justify-between px-6 gap-8 text-font-secondary"
>
  <div class="shrink-0">
    <img src="" alt="Logo image" class="h-10 w-auto" />
  </div>

  <nav class="flex-1">
    <ul class="flex gap-8 items-center h-full">
      <li>
        <a href="#" class="font-medium hover:text-highlight transition-all">
          Dashboard
        </a>
      </li>
      <li>
        <a href="#" class="ont-medium hover:text-highlight transition-all">
          Learning paths
        </a>
      </li>
      <li>
        <a href="#" class="font-medium hover:text-highlight transition-all">
          Community
        </a>
      </li>
    </ul>
  </nav>

  <div class="flex items-center gap-4">
    <div class="flex flex-col gap-1 text-right">
      <p class="text-xs text-gray-400">No role</p>
      <p class="text-sm font-semibold text-yellow-400">Level 9</p>
    </div>
    <progress class="h-2 w-24 accent-yellow-400"></progress>
    <Avatar
      src="/path-to-your-orc.png"
      size="xs"
      faction="undead"
      client:load
    />
  </div>
</header>
