---
import FreeResources from "./FreeResources.astro";
import JoinCommunity from "./JoinCommunity.astro";
import { Button } from "./ui/warcraftcn/button";
---

<section
  class="w-full min-h-screen p-6 md:p-16 text-font font-secondary flex flex-col justify-center items-center"
>
  <div
    class="w-full flex flex-col gap-12 md:gap-16 items-center justify-center"
  >
    <div
      class="w-full max-w-3xl flex flex-col items-center text-center md:items-start md:text-start"
    >
      <h1 class="text-4xl md:text-8xl font-primary mb-6 leading-tight">
        Learn to code <br class="hidden md:block" /> free
      </h1>
      <p class="text-lg md:text-2xl text-font-secondary mb-8">
        / Begin the path of learning
      </p>

      <a href="/learn">
        <Button
          client:visible
          variant="default"
          className="px-8 py-4  text-white font-bold rounded-sm hover:scale-105 transition-transform"
        >
          Get started
        </Button>
      </a>
    </div>

    <div
      class="w-full max-w-5xl grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8"
    >
      <FreeResources />
      <JoinCommunity />
    </div>
  </div>
</section>
