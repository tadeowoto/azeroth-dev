---
import FreeResources from "./FreeResources.astro";
import JoinCommunity from "./JoinCommunity.astro";
---

<section
  class="w-full h-full p-16 text-font font-secondary gap-20 flex flex-col justify-center items-start"
>
  <div class="w-full flex flex-col gap-16">
    <div class="max-w-3xl">
      <h1 class="text-8xl font-primary mb-8">
        Learn to code <br /> free
      </h1>
      <p class="text-2xl text-font-secondary mb-6">
        / Begin the path of learning
      </p>
      <button
        class="px-6 py-3 bg-highlight text-slate-900 font-semibold rounded hover:opacity-90 transition"
        >Get started</button
      >
    </div>

    <div class="w-full max-w-4xl grid grid-cols-2 gap-8">
      <FreeResources />
      <JoinCommunity />
    </div>
  </div>
</section>

<style></style>
