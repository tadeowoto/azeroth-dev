---
import Layout from "@/layouts/Layout.astro";
---

<Layout>
  <main
    class="w-full min-h-screen bg-red-300 flex items-center justify-start flex-col p-16"
  >
    <h1 class="text-7xl font-primary">Take your next path</h1>
    <div class="w-full h-full">
      <h2 class="text-3xl text-center mt-5">Learn to code</h2>
      <ul
        class="w-full h-full grid grid-cols-2 grid-rows-2 place-items-center mt-5 gap-3"
      >
        <li>JavaScript</li>
        <li>TypeScript</li>
        <li>Python</li>
        <li>Go</li>
        <li>Java</li>
        <li>PHP</li>
        <li>SQL</li>
      </ul>
    </div>
  </main>
</Layout>
