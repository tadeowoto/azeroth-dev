---
import Layout from "@/layouts/Layout.astro";
import {
  Card,
  CardContent,
  CardDescription,
  CardFooter,
  CardHeader,
  CardTitle,
} from "@/components/ui/warcraftcn/card";
import { Button } from "@/components/ui/warcraftcn/button";
import type { Path } from "@/types/types";
import { getPaths } from "@/services/path";

const paths = await getPaths();
---

<Layout>
  <main
    class="w-full min-h-screen flex items-center justify-start flex-col p-6 md:p-16"
  >
    <h1
      class="text-4xl md:text-7xl font-primary text-font text-center text-balance leading-tight"
    >
      Take your next path
    </h1>

    <div class="w-full max-w-6xl font-secondary mt-10">
      <h2
        class="text-2xl md:text-3xl text-center text-balance text-highlight mb-8"
      >
        Free online resources
      </h2>

      <ul class="grid grid-cols-1 md:grid-cols-2 gap-6 place-items-center">
        {
          !paths || paths.length === 0 ? (
            <div class="col-span-full py-10 text-center">
              <p class="text-font-secondary font-secondary italic">
                No paths available at the moment.
              </p>
            </div>
          ) : (
            paths.map((path: Path) => (
              <Card
                client:visible
                className="font-primary flex flex-col w-full max-w-md h-full"
              >
                <CardHeader className="w-full flex flex-col justify-center items-center  text-center md:text-left">
                  <CardTitle className="text-xl md:text-2xl">
                    {path.title}
                  </CardTitle>
                </CardHeader>

                <CardContent className="grow text-center md:text-left">
                  <p class="text-sm text-font-secondary text-pretty">
                    {path.description}
                  </p>
                </CardContent>

                <CardFooter className="w-full pb-6 flex items-center justify-center">
                  <a href={`learn/${path.slug}`}>
                    <Button className="w-full py-2 text-md">
                      Begin the path
                    </Button>
                  </a>
                </CardFooter>
              </Card>
            ))
          )
        }
      </ul>
    </div>
  </main>
</Layout>
