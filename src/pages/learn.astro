---
import Layout from "@/layouts/Layout.astro";
import {
  Card,
  CardContent,
  CardDescription,
  CardFooter,
  CardHeader,
  CardTitle,
} from "@/components/ui/warcraftcn/card";
import { Button } from "@/components/ui/warcraftcn/button";
import type { Path } from "@/types/types";
import { getPaths } from "@/services/path";

const paths = await getPaths();
---

<Layout>
  <main
    class="w-full min-h-screen flex items-center justify-start flex-col p-6 md:p-16"
  >
    <h1
      class="text-4xl md:text-7xl font-primary text-font text-center leading-tight"
    >
      Take your next path
    </h1>

    <div class="w-full max-w-6xl font-secondary mt-10">
      <h2 class="text-2xl md:text-3xl text-center text-highlight mb-8">
        Free online resources
      </h2>

      <ul class="grid grid-cols-1 md:grid-cols-2 gap-6 place-items-center">
        {
          paths.map((path: Path) => (
            <Card
              client:visible
              className="font-primary flex flex-col items-center justify-center w-full max-w-md h-full bg-slate-900/40 border-border-color"
            >
              <CardHeader className="w-full text-center md:text-left">
                <CardTitle className="text-xl md:text-2xl">
                  {path.title}
                </CardTitle>
                <CardDescription className="text-xs md:text-sm font-secondary">
                  {path.description}
                </CardDescription>
              </CardHeader>

              <CardContent className="grow text-center md:text-left">
                <p class="text-sm text-font-secondary">
                  Explore the curriculum and start building projects.
                </p>
              </CardContent>

              <CardFooter className="w-full pb-6">
                <a class="w-full" href={`learn/${path.slug}`}>
                  <Button className="w-full py-6 text-md">
                    Begin the path of {path.title}
                  </Button>
                </a>
              </CardFooter>
            </Card>
          ))
        }
      </ul>
    </div>
  </main>
</Layout>
